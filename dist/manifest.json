{
  "manifest_version": 3,
  "name": "Clyde",
  "version": "0.1.0",
  "description": "Watches Slack and meetings for commitments. Say the word.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "sidePanel",
    "tabs",
    "nativeMessaging",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "https://app.slack.com/*",
    "https://*.slack.com/*",
    "https://docs.google.com/*",
    "https://mail.google.com/*",
    "https://api.anthropic.com/*",
    "https://www.googleapis.com/*",
    "https://accounts.google.com/*",
    "https://slack.com/api/*",
    "https://gmail.googleapis.com/*",
    "https://api.github.com/*",
    "https://*.atlassian.net/*",
    "https://www.anthropic.com/*",
    "https://hacker-news.firebaseio.com/*",
    "https://export.arxiv.org/*",
    "https://openai.com/*",
    "https://huggingface.co/*",
    "https://www.theverge.com/*",
    "https://techcrunch.com/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/slack.ts-Da7hxywQ.js"
      ],
      "matches": [
        "https://app.slack.com/*",
        "https://*.slack.com/*"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "assets/google-docs.ts-q3CVe_Aj.js"
      ],
      "matches": [
        "https://docs.google.com/document/*"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "assets/gmail.ts-loader-DWQpWrnV.js"
      ],
      "matches": [
        "https://mail.google.com/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "chrome_url_overrides": {
    "newtab": "src/newtab/index.html"
  },
  "action": {
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "https://*.slack.com/*",
        "https://app.slack.com/*"
      ],
      "resources": [
        "assets/slack.ts-Da7hxywQ.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://docs.google.com/*"
      ],
      "resources": [
        "assets/google-docs.ts-q3CVe_Aj.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "resources": [
        "assets/constants-CxY9Wmmy.js",
        "assets/gmail.ts-CeerWWGL.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
